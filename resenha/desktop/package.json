{
  "name": "resenha",
  "productName": "Resenha",
  "version": "1.0.0",
  "description": "Chat de voz, vídeo e texto para você e seus amigos",
  "main": "main.js",
  "private": true,
  "author": "Resenha",
  "license": "MIT",
  "resenha": {
    "defaultServer": ""
  },
  "scripts": {
    "start": "electron .",
    "icon": "node ../tools/make-icons.js",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "app.resenha.desktop",
    "productName": "Resenha",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "connect.html",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "artifactName": "Resenha-Setup-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.social-networking",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "O Resenha usa o microfone para chamadas de voz.",
        "NSCameraUsageDescription": "O Resenha usa a câmera para chamadas de vídeo."
      },
      "artifactName": "Resenha-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Network",
      "artifactName": "Resenha-${version}.${ext}"
    },
    "publish": null
  }
}
