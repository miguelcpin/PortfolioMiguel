# Porta HTTP do servidor
PORT=3000
# Código de convite: quem não souber este código não consegue criar conta
INVITE_CODE=troque-isto
# Nome do servidor exibido no app
SERVER_NAME=Resenha
# Máximo de contas (padrão 10)
MAX_USERS=10
# Tamanho máximo por arquivo enviado, em MB
MAX_UPLOAD_MB=500
# Pasta onde ficam banco de dados e uploads
DATA_DIR=./data
# TURN (opcional, mas recomendado quando alguém estiver atrás de NAT restritivo / 4G)
# Separe várias URLs por vírgula
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
# TURN da Cloudflare (recomendado): o servidor gera credenciais temporárias sozinho.
# Painel da Cloudflare > Realtime > TURN Server > Create: copie o "Turn Token ID" e o "API Token".
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
# Trava de gastos do TURN: para de usar o TURN ao passar deste consumo no mês (a Cloudflare
# cobra só acima de 1.000 GB). Token com permissão "Account Analytics: Read".
CF_ACCOUNT_ID=
CF_ANALYTICS_TOKEN=
TURN_MONTHLY_LIMIT_GB=800
